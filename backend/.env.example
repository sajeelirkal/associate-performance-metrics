# GitHub OAuth App credentials
# Create your OAuth App at: https://github.com/settings/developers
#   Homepage URL:              http://localhost:5173
#   Authorization callback URL: http://localhost:8000/api/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Optional — defaults shown below
# GH_SCOPE=read:user,repo
# FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated browser origins allowed to call the API directly.
# Defaults to FRONTEND_ORIGIN. Set this when running more than one frontend.
# FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# GitLab self-managed — SSL verification (default: false for internal CAs)
# GITLAB_SSL_VERIFY=false
